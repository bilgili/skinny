# Synthetic hostless coverage scene for the pbrt material mapper
# (change: pbrt-material-shared-resolver, task 1.2).
#
# Not a render target — it carries no reference EXR and is NOT in
# tests/pbrt/corpus/manifest.json. Its only job is to put EVERY material-type
# branch of skinny.pbrt.materials (and every param read inside those branches)
# under the byte-identity import diff, including the branches no suite or
# corpus scene reaches: `coatedconductor`, `diffusetransmission`, `interface`,
# `thindielectric`, the unknown-material fallback, and the one-sided /
# flavour-divergent reads (`transmittance`, subsurface `reflectance`/`radius`,
# `interface.eta`, `conductor.roughness` vs top-level `roughness`).
#
# Textured, named-spectrum, spectrum-file and unresolved-texture variants are
# included because the promoting accessors emit notes (and escalate
# EXACT -> APPROX) as a side effect of the read — notes and statuses are import
# output, so they are part of the diff.
LookAt 0 1.5 6  0 0.7 0  0 1 0
Camera "perspective" "float fov" 30
Sampler "independent" "integer pixelsamples" 4
Integrator "path" "integer maxdepth" 5
Film "rgb" "integer xresolution" 32 "integer yresolution" 32 "string filename" "all_mtypes.exr"
WorldBegin

LightSource "infinite" "rgb L" [0.4 0.4 0.4]

Texture "uvtex" "spectrum" "imagemap" "string filename" "../corpus/texture_uv.png"
Texture "rtex" "float" "imagemap" "string filename" "../corpus/texture_uv.png"
Texture "scaledtex" "spectrum" "scale" "texture tex" "uvtex" "float scale" 0.5
# unsupported texture class: resolves to None -> "unresolved/unsupported" note
Texture "checkertex" "spectrum" "checkerboard" "rgb tex1" [1 0 0] "rgb tex2" [0 0 1]
Texture "checkerf" "float" "checkerboard" "float tex1" 0.1 "float tex2" 0.9

# --- empty / none / unknown --------------------------------------------- #
AttributeBegin
  Material ""
  Shape "trianglemesh" "point3 P" [ -0.1 0 0  0.1 0 0  0 0.2 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "none"
  Shape "trianglemesh" "point3 P" [ 0.2 0 0  0.4 0 0  0.3 0.2 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "wibble" "float roughness" 0.3
  Shape "trianglemesh" "point3 P" [ 0.5 0 0  0.7 0 0  0.6 0.2 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- interface (null boundary) ------------------------------------------ #
AttributeBegin
  Material "interface"
  Shape "trianglemesh" "point3 P" [ 0.8 0 0  1.0 0 0  0.9 0.2 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- diffuse: constant / textured / scaled / unresolved / named spectrum -- #
AttributeBegin
  Material "diffuse" "rgb reflectance" [0.2 0.4 0.6]
  Shape "trianglemesh" "point3 P" [ -0.1 0.3 0  0.1 0.3 0  0 0.5 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "diffuse" "texture reflectance" "uvtex"
  Shape "trianglemesh"
    "point3 P" [ 0.2 0.3 0  0.4 0.3 0  0.4 0.5 0  0.2 0.5 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

AttributeBegin
  Material "diffuse" "texture reflectance" "scaledtex"
  Shape "trianglemesh"
    "point3 P" [ 0.5 0.3 0  0.7 0.3 0  0.7 0.5 0  0.5 0.5 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

AttributeBegin
  Material "diffuse" "texture reflectance" "checkertex"
  Shape "trianglemesh" "point3 P" [ 0.8 0.3 0  1.0 0.3 0  0.9 0.5 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "diffuse" "spectrum reflectance" "metal-Au-eta"
  Shape "trianglemesh" "point3 P" [ 1.1 0.3 0  1.3 0.3 0  1.2 0.5 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- conductor: named metal / eta+k rgb / unknown name / spectrum file ---- #
AttributeBegin
  Material "conductor" "spectrum eta" "metal-Au-eta" "spectrum k" "metal-Au-k" "float roughness" 0.1
  Shape "trianglemesh" "point3 P" [ -0.1 0.6 0  0.1 0.6 0  0 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb eta" [0.2 0.9 1.1] "rgb k" [3.9 2.4 2.1] "float roughness" 0.25
    "bool remaproughness" false
  Shape "trianglemesh" "point3 P" [ 0.2 0.6 0  0.4 0.6 0  0.3 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "conductor" "spectrum eta" "metal-Xx-eta" "float roughness" 0.2
  Shape "trianglemesh" "point3 P" [ 0.5 0.6 0  0.7 0.6 0  0.6 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "conductor" "spectrum eta" "spds/metal.spd" "float roughness" 0.2
  Shape "trianglemesh" "point3 P" [ 0.8 0.6 0  1.0 0.6 0  0.9 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# conductor with explicit reflectance (skips the eta/k chain entirely)
AttributeBegin
  Material "conductor" "rgb reflectance" [0.9 0.7 0.3] "float uroughness" 0.05 "float vroughness" 0.4
  Shape "trianglemesh" "point3 P" [ 1.1 0.6 0  1.3 0.6 0  1.2 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# conductor with a texture-bound roughness (roughness texture postlude)
AttributeBegin
  Material "conductor" "texture roughness" "rtex"
  Shape "trianglemesh"
    "point3 P" [ 1.4 0.6 0  1.6 0.6 0  1.6 0.8 0  1.4 0.8 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

# conductor with an UNRESOLVED roughness texture (note + EXACT -> APPROX)
AttributeBegin
  Material "conductor" "texture roughness" "checkerf"
  Shape "trianglemesh" "point3 P" [ 1.7 0.6 0  1.9 0.6 0  1.8 0.8 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- dielectric / thindielectric ---------------------------------------- #
AttributeBegin
  Material "dielectric" "float eta" 1.7 "float roughness" 0.05
  Shape "trianglemesh" "point3 P" [ -0.1 0.9 0  0.1 0.9 0  0 1.1 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "dielectric" "spectrum eta" "glass-BK7"
  Shape "trianglemesh" "point3 P" [ 0.2 0.9 0  0.4 0.9 0  0.3 1.1 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# named spectrum on eta that is NOT a known glass -> note + default
AttributeBegin
  Material "dielectric" "spectrum eta" "glass-ZZ9"
  Shape "trianglemesh" "point3 P" [ 0.5 0.9 0  0.7 0.9 0  0.6 1.1 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# texture-bound eta -> scalar-degradation note (target-worded per flavour)
AttributeBegin
  Material "dielectric" "texture eta" "rtex"
  Shape "trianglemesh"
    "point3 P" [ 0.8 0.9 0  1.0 0.9 0  1.0 1.1 0  0.8 1.1 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

AttributeBegin
  Material "thindielectric" "float eta" 1.33
  Shape "trianglemesh" "point3 P" [ 1.1 0.9 0  1.3 0.9 0  1.2 1.1 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- coateddiffuse ------------------------------------------------------- #
AttributeBegin
  Material "coateddiffuse" "rgb reflectance" [0.3 0.5 0.7] "float roughness" 0.15
    "float interface.eta" 1.6
  Shape "trianglemesh" "point3 P" [ -0.1 1.2 0  0.1 1.2 0  0 1.4 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# coat roughness bound to a texture: USD emits an extra adapter note
AttributeBegin
  Material "coateddiffuse" "texture roughness" "rtex"
  Shape "trianglemesh"
    "point3 P" [ 0.2 1.2 0  0.4 1.2 0  0.4 1.4 0  0.2 1.4 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

# interface.eta bound to a texture: read only under the mtlx flavour
AttributeBegin
  Material "coateddiffuse" "texture interface.eta" "rtex"
  Shape "trianglemesh"
    "point3 P" [ 0.5 1.2 0  0.7 1.2 0  0.7 1.4 0  0.5 1.4 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

# --- coatedconductor (drift 1: conductor.roughness vs top-level roughness) - #
AttributeBegin
  Material "coatedconductor" "spectrum conductor.eta" "metal-Ag-eta"
    "spectrum conductor.k" "metal-Ag-k"
    "float conductor.roughness" 0.02 "float roughness" 0.44
    "float interface.eta" 1.55 "float interface.roughness" 0.08
  Shape "trianglemesh" "point3 P" [ -0.1 1.5 0  0.1 1.5 0  0 1.7 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# coatedconductor with a texture-bound conductor.roughness (mtlx-only read)
AttributeBegin
  Material "coatedconductor" "texture conductor.roughness" "rtex" "float roughness" 0.3
  Shape "trianglemesh"
    "point3 P" [ 0.2 1.5 0  0.4 1.5 0  0.4 1.7 0  0.2 1.7 0 ]
    "integer indices" [ 0 1 2  0 2 3 ]
    "point2 uv" [ 0 0  1 0  1 1  0 1 ]
AttributeEnd

# coatedconductor with anisotropic top-level roughness (USD-only read path)
AttributeBegin
  Material "coatedconductor" "float uroughness" 0.05 "float vroughness" 0.3
  Shape "trianglemesh" "point3 P" [ 0.5 1.5 0  0.7 1.5 0  0.6 1.7 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- diffusetransmission ------------------------------------------------- #
AttributeBegin
  Material "diffusetransmission" "rgb reflectance" [0.3 0.3 0.1] "rgb transmittance" [0.1 0.6 0.2]
  Shape "trianglemesh" "point3 P" [ -0.1 1.8 0  0.1 1.8 0  0 2.0 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# transmittance bound to a texture: mtlx-only read, so only mtlx notes it
AttributeBegin
  Material "diffusetransmission" "texture transmittance" "checkertex"
  Shape "trianglemesh" "point3 P" [ 0.2 1.8 0  0.4 1.8 0  0.3 2.0 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- subsurface (all four coefficient-precedence routes) ----------------- #
AttributeBegin
  Material "subsurface" "string name" "skin1"
  Shape "trianglemesh" "point3 P" [ -0.1 2.1 0  0.1 2.1 0  0 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "subsurface" "rgb sigma_a" [0.02 0.08 0.2] "rgb sigma_s" [2.5 3.2 4.0]
    "float g" 0.4 "float eta" 1.4 "float scale" 2.0
  Shape "trianglemesh" "point3 P" [ 0.2 2.1 0  0.4 2.1 0  0.3 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "subsurface" "rgb reflectance" [0.7 0.4 0.3] "rgb mfp" [1.2 0.8 0.5]
    "rgb radius" [0.9 0.6 0.4]
  Shape "trianglemesh" "point3 P" [ 0.5 2.1 0  0.7 2.1 0  0.6 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# Every subsurface param binding is now representable. A NAMED-SPECTRUM `eta`
# used to crash (fixed by subsurface-eta-single-owner); a TEXTURE- or
# named-spectrum-bound coefficient used to crash too, and a `blackbody` or inline
# sampled spectrum silently parsed into its raw tokens (both fixed by
# subsurface-promoting-accessors). A texture-bound COEFFICIENT reports SKIPPED —
# the imported interior medium is homogeneous, so a per-intersection texture is
# unrepresentable, not approximate.
AttributeBegin
  Material "subsurface" "spectrum eta" "glass-LASF9"
  Shape "trianglemesh" "point3 P" [ 1.1 2.1 0  1.3 2.1 0  1.2 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "subsurface" "blackbody sigma_a" [6500] "rgb sigma_s" [1 1 1]
  Shape "trianglemesh" "point3 P" [ 1.4 2.1 0  1.6 2.1 0  1.5 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "subsurface" "spectrum mfp" [400 .1 700 .9] "rgb reflectance" [0.6 0.5 0.4]
  Shape "trianglemesh" "point3 P" [ 1.7 2.1 0  1.9 2.1 0  1.8 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

AttributeBegin
  Material "subsurface" "float eta" 1.45 "rgb reflectance" [0.6 0.5 0.4]
  Shape "trianglemesh" "point3 P" [ 0.8 2.1 0  1.0 2.1 0  0.9 2.3 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd

# --- emissive material (emission encoding differs per flavour) ----------- #
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [7 5 3]
  Material "diffuse" "rgb reflectance" [0.8 0.8 0.8]
  Shape "trianglemesh" "point3 P" [ -1 3 -1  1 3 -1  1 3 1  -1 3 1 ] "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd

# emissive shape with NO material at all (mapper falls back to an empty ParamSet)
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [2 2 2]
  Shape "trianglemesh" "point3 P" [ -1 3.5 -1  1 3.5 -1  0 3.5 1 ] "integer indices" [ 0 1 2 ]
AttributeEnd
